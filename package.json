{
  "name": "mulat",
  "version": "0.1.0",
  "private": true,
  "description": "Ask deep questions about your own files without uploading them to the cloud.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "fixture:generate": "node fixtures/generate.mjs",
    "mulat": "tsx apps/cli/src/main.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.1",
    "vitest": "^5.0.1"
  }
}
